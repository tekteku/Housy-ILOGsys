# Housy Tunisia Production Environment Configuration

# Database Configuration
DATABASE_URL=postgresql://postgres:0000@postgres:5432/housy_tunisia
POSTGRES_DB=housy_tunisia
POSTGRES_USER=postgres
POSTGRES_PASSWORD=0000

# Redis Configuration  
REDIS_URL=redis://redis:6379

# Application Configuration
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# JWT Configuration
JWT_SECRET=HousyTunisiaJWTSecretPROD2025!MustChangeThis

# Encryption
BCRYPT_ROUNDS=12

# CORS Configuration
CORS_ORIGIN=https://housy.tn

# Logging
LOG_LEVEL=warn

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Session Configuration
SESSION_SECRET=HousyTunisiaSessionSecretPROD2025!MustChangeThis
SESSION_MAX_AGE=86400000

# Tunisian Business Configuration
DEFAULT_CURRENCY=TND
DEFAULT_TIMEZONE=Africa/Tunis
TAX_RATE=19
BUSINESS_REGISTRATION_PREFIX=TN
