# Configuration pour l'intégration des nouveaux modèles Ollama
# Date: 2025-06-16
# IMPORTANT: Ces paramètres sont pour le développement et la configuration système

# =============================================================================
# CONFIGURATION OLLAMA ÉTENDUE
# =============================================================================

# URL de l'API Ollama (locale)
OLLAMA_API_URL=http://localhost:11434

# Modèles prioritaires (ordre de préférence)
OLLAMA_PREFERRED_MODELS=llama3.1,deepseek-coder,qwen2.5-coder,qwen,mistral,phi

# Modèle par défaut pour les administrateurs
OLLAMA_DEFAULT_ADMIN_MODEL=deepseek-coder

# Modèle par défaut pour les utilisateurs
OLLAMA_DEFAULT_USER_MODEL=qwen

# =============================================================================
# CONFIGURATION DU TRACKING (DÉVELOPPEMENT UNIQUEMENT)
# =============================================================================

# Activer le tracking des modèles (development/staging uniquement)
AI_TRACKING_ENABLED=true

# Niveau de logging pour le tracking
AI_TRACKING_LOG_LEVEL=debug

# Rétention des données de tracking (en jours)
AI_TRACKING_RETENTION_DAYS=30

# =============================================================================
# CONFIGURATION MODÈLES CLOUD
# =============================================================================

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# Anthropic Claude
ANTHROPIC_API_KEY=your-anthropic-key-here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# DeepSeek (Cloud)
DEEPSEEK_API_KEY=your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-chat

# =============================================================================
# CONFIGURATION SÉCURITÉ ET PERMISSIONS
# =============================================================================

# Rôles autorisés pour Ollama local
OLLAMA_AUTHORIZED_ROLES=admin,super_admin

# Activation du mode développement (pour tracking)
NODE_ENV=development

# Niveau de log général
LOG_LEVEL=info

# =============================================================================
# CONFIGURATION PERFORMANCE
# =============================================================================

# Timeout pour les requêtes Ollama (en millisecondes)
OLLAMA_REQUEST_TIMEOUT=30000

# Timeout pour les requêtes cloud (en millisecondes)
CLOUD_AI_REQUEST_TIMEOUT=15000

# Température par défaut pour les modèles
AI_DEFAULT_TEMPERATURE=0.7

# Température pour les estimations (plus conservateur)
AI_ESTIMATION_TEMPERATURE=0.5

# =============================================================================
# MONITORING ET OBSERVABILITÉ
# =============================================================================

# Activer les métriques de performance
ENABLE_PERFORMANCE_METRICS=true

# Activer les logs détaillés pour debugging
ENABLE_DEBUG_LOGS=true

# Activer l'audit des accès aux modèles restreints
ENABLE_SECURITY_AUDIT=true

# =============================================================================
# NOTES IMPORTANTES
# =============================================================================

# 1. Le tracking est INVISIBLE à l'utilisateur final
# 2. Les permissions modèles sont transparentes pour l'UX
# 3. Les fallbacks automatiques assurent la continuité de service
# 4. Toute la logique de sélection de modèle est côté serveur

# =============================================================================
# COMMANDES OLLAMA UTILES
# =============================================================================

# Installer les nouveaux modèles :
# ollama pull deepseek-coder
# ollama pull qwen2.5-coder  
# ollama pull qwen

# Vérifier les modèles installés :
# ollama list

# Tester un modèle :
# ollama run deepseek-coder "Test de fonctionnement"
