# Housy Tunisia Development Environment Configuration

# Database Configuration
DATABASE_URL=postgresql://postgres:0000@localhost:5432/housy_tunisia
POSTGRES_DB=housy_tunisia
POSTGRES_USER=postgres
POSTGRES_PASSWORD=0000
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Configuration
REDIS_URL=redis://localhost:6380
REDIS_HOST=localhost
REDIS_PORT=6380

# Application Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# JWT Configuration
JWT_SECRET=HousyTunisiaJWTSecret2025!ChangeThisInProduction

# Encryption
BCRYPT_ROUNDS=12

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# API Keys (Optional - for AI features)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Logging
LOG_LEVEL=info

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Session Configuration
SESSION_SECRET=HousyTunisiaSessionSecret2025!ChangeThis
SESSION_MAX_AGE=86400000

# Tunisian Business Configuration
DEFAULT_CURRENCY=TND
DEFAULT_TIMEZONE=Africa/Tunis
TAX_RATE=19
BUSINESS_REGISTRATION_PREFIX=TN
