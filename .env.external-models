# Configuration pour l'intégration Perplexity + OpenAI avec Ollama
# Date: 17 juin 2025

# =============================================================================
# CLÉS API POUR MODÈLES EXTERNES
# =============================================================================

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_ORG_ID=org-your-org-id-here

# Perplexity AI
PPLX_API_KEY=pplx-your-perplexity-api-key-here

# Anthropic Claude (si besoin)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# =============================================================================
# CONFIGURATION MODÈLES EXTERNES
# =============================================================================

# OpenAI Models
OPENAI_MODELS=gpt-4-turbo-preview,gpt-3.5-turbo,gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# Perplexity Models  
PPLX_MODELS=llama-3.1-sonar-large-128k-online,llama-3.1-sonar-small-128k-chat
PPLX_MAX_TOKENS=2000
PPLX_TEMPERATURE=0.5

# =============================================================================
# CONFIGURATION PROXY UNIFIÉ
# =============================================================================

# Activer le proxy unifié pour tous les modèles
UNIFIED_MODEL_PROXY=true

# URL de base pour le proxy (si différent)
UNIFIED_PROXY_URL=http://localhost:8000

# Timeout pour les requêtes externes (ms)
EXTERNAL_MODEL_TIMEOUT=30000

# =============================================================================
# CONFIGURATION POUR ESTIMATION HOUSY
# =============================================================================

# Ordre de préférence des modèles pour estimation
ESTIMATION_MODEL_PRIORITY=llama3.1,qwen2.5-coder,gpt-4-turbo,perplexity-online

# Modèle de fallback si tous échouent
ESTIMATION_FALLBACK_MODEL=phi

# Activer les modèles externes pour estimation
ALLOW_EXTERNAL_ESTIMATION=true

# =============================================================================
# SÉCURITÉ ET MONITORING
# =============================================================================

# Log des appels aux modèles externes
LOG_EXTERNAL_CALLS=true

# Limite de requêtes par minute (pour éviter dépassement quotas)
EXTERNAL_RATE_LIMIT=60

# Activer le cache des réponses pour économiser les appels API
ENABLE_RESPONSE_CACHE=true
CACHE_TTL_MINUTES=30

# =============================================================================
# INSTRUCTIONS POUR CONFIGURATION
# =============================================================================

# 1. OBTENIR LES CLÉS API:
#    - OpenAI: https://platform.openai.com/api-keys
#    - Perplexity: https://docs.perplexity.ai/docs/getting-started
#    - Anthropic: https://console.anthropic.com/

# 2. REMPLACER LES VALEURS:
#    - Copier ce fichier vers .env.external-models
#    - Remplacer les clés par vos vraies clés API
#    - Ajuster les configurations selon vos besoins

# 3. TESTER LA CONFIGURATION:
#    - Lancer: node test-all-models.cjs
#    - Vérifier les connexions et performances

# =============================================================================
# EXEMPLE DE COMMANDES POUR TESTER
# =============================================================================

# Test de tous les modèles
# node test-all-models.cjs

# Test spécifique Ollama
# ollama list

